{
  "schema_version": "health-prediction.v1",
  "allowed_prediction_modes": [
    "value",
    "range",
    "risk",
    "anomaly",
    "derived",
    "not_supported"
  ],
  "value_labels": {
    "measured": "直接测量值",
    "estimated": "估计值",
    "predicted": "预测值"
  },
  "metrics": {
    "bp": {"prediction_mode": "value", "horizons_days": [1, 3, 7], "target_kind": "future_value"},
    "glucose": {"prediction_mode": "value", "horizons_days": [1, 3, 7], "target_kind": "conditioned_future_value"},
    "hr": {"prediction_mode": "value", "horizons_days": [1, 3, 7], "target_kind": "future_value"},
    "sleep": {"prediction_mode": "range", "horizons_days": [1, 7], "target_kind": "future_range"},
    "spo2": {"prediction_mode": "anomaly", "horizons_days": [1], "target_kind": "abnormal_event"},
    "weight": {"prediction_mode": "value", "horizons_days": [7, 14, 30], "target_kind": "future_value"},
    "steps": {"prediction_mode": "range", "horizons_days": [1, 7], "target_kind": "future_range"},
    "temp": {"prediction_mode": "anomaly", "horizons_days": [1], "target_kind": "abnormal_event"},
    "resp": {"prediction_mode": "anomaly", "horizons_days": [1], "target_kind": "abnormal_event"},
    "grip": {"prediction_mode": "value", "horizons_days": [30, 90], "target_kind": "future_value"},
    "bodyfat": {"prediction_mode": "range", "horizons_days": [7, 30], "target_kind": "future_range"},
    "waist": {"prediction_mode": "value", "horizons_days": [30, 90], "target_kind": "future_value"},
    "uricacid": {"prediction_mode": "risk", "horizons_days": [30, 90], "target_kind": "abnormal_risk"},
    "cholesterol": {"prediction_mode": "risk", "horizons_days": [30, 90], "target_kind": "abnormal_risk"},
    "hba1c": {"prediction_mode": "risk", "horizons_days": [30, 90], "target_kind": "abnormal_risk"},
    "ecg": {"prediction_mode": "anomaly", "horizons_days": [0], "target_kind": "waveform_classification"},
    "egfr": {"prediction_mode": "derived", "horizons_days": [0], "target_kind": "formula_derived"},
    "creatinine": {"prediction_mode": "risk", "horizons_days": [30, 90], "target_kind": "abnormal_risk"},
    "urine_albumin": {"prediction_mode": "risk", "horizons_days": [30, 90], "target_kind": "abnormal_risk"}
  },
  "required_output_fields": [
    "schema_version",
    "metric",
    "prediction_mode",
    "value_kind",
    "display_label",
    "status",
    "horizon_days",
    "model",
    "abstained",
    "reason"
  ]
}
