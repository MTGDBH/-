{
  "name": "elderly-health-server",
  "version": "1.0.0",
  "description": "老年人健康管理网站 - 后端 API（Node + Express + SQLite）",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22 <23"
  },
  "scripts": {
    "start": "node src/index.js",
    "dev": "node --watch src/index.js",
    "seed": "node data/seed.js",
    "reset": "rm -f data/app.db && node data/seed.js",
    "test": "node scripts/run-tests.mjs core",
    "test:unit": "node scripts/run-tests.mjs unit",
    "test:integration": "node scripts/run-tests.mjs integration",
    "test:graphrag": "node scripts/run-tests.mjs graphrag",
    "test:curve": "node scripts/run-tests.mjs curve",
    "test:security": "node scripts/run-tests.mjs security",
    "test:syntax": "node scripts/run-tests.mjs syntax"
  },
  "dependencies": {
    "bcryptjs": "^3.0.3",
    "better-sqlite3": "^11.3.0",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "redis": "^5.8.2"
  }
}
