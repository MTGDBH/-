# ===== 服务端口 =====
PORT=3001

# ===== OpenAI 兼容接口 =====
# 填入后即调用真实 LLM；留空则自动走 Mock 智能体（规则回复）
# DeepSeek 优先级高于 OPENAI_API_KEY；二选一配置即可。
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-chat
# 按供应商控制台价格配置，用于监控中的估算成本；留空表示只统计 Token。
LLM_INPUT_COST_PER_1M_CNY=
LLM_CACHE_HIT_COST_PER_1M_CNY=
LLM_OUTPUT_COST_PER_1M_CNY=
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 站点 =====
# 允许的前端地址（逗号分隔）；Cookie 鉴权环境不要使用 *。
CORS_ORIGIN=http://localhost:3001,http://127.0.0.1:3001

# 总请求超时必须长于模型超时，避免客户端先收到 504 而后端继续写入消息。
DEEPSEEK_TIMEOUT_MS=45000
HTTP_REQUEST_TIMEOUT_MS=60000

# ===== 数据 =====
# SQLite 数据库文件路径（相对 server/ 目录）
DB_PATH=./data/app.db

# ===== 私有推理模型包（仅由本机安装脚本读取）=====
# 使用签名 HTTPS URL；安装脚本不会输出完整地址。留空时主系统降级启动。
MODEL_BUNDLE_URL=
MODEL_BUNDLE_SHA256=
# 隐私中心：个人导出默认每 24 小时最多 3 次；最小化审计默认保留 180 天。
PRIVACY_EXPORT_MAX_PER_DAY=3
PRIVACY_AUDIT_RETENTION_DAYS=180
# 逗号分隔；影响普通页面展示，不会把密码/令牌等加入导出。
PRIVACY_MASK_FIELDS=emergency_phone,ip_hash,user_agent_hash,request_id
