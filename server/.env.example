# ===== 服务端口 =====
PORT=3001

# ===== OpenAI 兼容接口 =====
# 填入后即调用真实 LLM；留空则自动走 Mock 智能体（规则回复）
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# ===== 站点 =====
# 允许的前端地址（逗号分隔），开发期一般是 *
CORS_ORIGIN=http://localhost:3000,http://127.0.0.1:5500,*

# ===== 数据 =====
# SQLite 数据库文件路径（相对 server/ 目录）
DB_PATH=./data/app.db

# ===== 私有推理模型包（仅由本机安装脚本读取）=====
# 使用签名 HTTPS URL；安装脚本不会输出完整地址。留空时主系统降级启动。
MODEL_BUNDLE_URL=
MODEL_BUNDLE_SHA256=
# 隐私中心：个人导出默认每 24 小时最多 3 次；最小化审计默认保留 180 天。
PRIVACY_EXPORT_MAX_PER_DAY=3
PRIVACY_AUDIT_RETENTION_DAYS=180
# 逗号分隔；影响普通页面展示，不会把密码/令牌等加入导出。
PRIVACY_MASK_FIELDS=emergency_phone,ip_hash,user_agent_hash,request_id
