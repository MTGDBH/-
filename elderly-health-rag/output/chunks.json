  {
    "id": "ada_older_adults_2025:0",
    "disease": "diabetes",
    "section": "老年人综合评估",
    "text": "老年糖尿病管理应同时评估医疗、心理、功能、自我管理能力和社会支持。还应关注认知、抑郁、跌倒、虚弱、持续疼痛、低血糖和多重用药等老年综合征。",
    "source": "ada_older_adults_2025.md",
    "citation": "ada_older_adults_2025.md#老年人综合评估",
    "evidence_level": "professional_guideline",
