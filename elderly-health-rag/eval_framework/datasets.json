{
  "schema_version": "dataset-registry.v1",
  "policy": "Never average across dataset_split. regression_internal is development regression only, never external validation.",
  "datasets": [
    {
      "dataset_split": "regression_internal",
      "source": "../eval/golden_questions.json",
      "loader": "legacy_golden_adapter",
      "release_role": "regression_only"
    },
    {
      "dataset_split": "blind",
      "collection_name": "blind_internal",
      "recommended_minimum_cases": 100,
      "source": "cases/blind.json",
      "loader": "unified_case",
      "release_role": "blind_validation"
    },
    {
      "dataset_split": "external",
      "collection_name": "external_clinician",
      "recommended_minimum_cases": 50,
      "source": "cases/external.json",
      "loader": "unified_case",
      "release_role": "external_validation"
    }
  ]
}
