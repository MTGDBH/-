{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://evicare.local/schema/evaluation-case.v1.json",
  "title": "Leakage-resistant GraphRAG evaluation case",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "case_id", "dataset_split", "question", "audience", "patient_context",
    "relevant_evidence_ids", "acceptable_relations", "forbidden_claims",
    "urgency_label", "required_abstention", "annotator_ids", "adjudication_status"
  ],
  "properties": {
    "case_id": {"type": "string", "pattern": "^[A-Za-z0-9_.:-]+$", "minLength": 1},
    "dataset_split": {"enum": ["regression_internal", "blind", "external"]},
    "question": {"type": "string", "minLength": 1},
    "audience": {"type": "string", "minLength": 1},
    "patient_context": {"type": "object", "additionalProperties": true},
    "relevant_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "acceptable_relations": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["path_id", "edges"],
        "properties": {
          "path_id": {"type": "string"},
          "edges": {
            "type": "array", "minItems": 1,
            "items": {
              "type": "object", "additionalProperties": false,
              "required": ["source", "relation", "target"],
              "properties": {
                "source": {"type": "string"}, "relation": {"type": "string"},
                "target": {"type": "string"},
                "evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
              }
            }
          }
        }
      }
    },
    "forbidden_claims": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "urgency_label": {"enum": ["emergency", "urgent", "routine", "not_applicable"]},
    "required_abstention": {"type": "boolean"},
    "annotator_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
    "adjudication_status": {"enum": ["unannotated", "in_progress", "adjudicated", "retired"]},
    "test_design": {
      "type": "object", "additionalProperties": true,
      "properties": {
        "kind": {"enum": ["standard", "personalization", "counterfactual_evidence_deletion", "irrelevant_record_robustness", "prompt_injection", "malicious_question"]},
        "pair_id": {"type": "string"},
        "variant": {"enum": ["baseline", "intervention"]},
        "trigger_factors": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "removed_evidence_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "added_irrelevant_record_ids": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "provenance": {"type": "object", "additionalProperties": true}
  }
}
